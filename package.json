{
  "name": "strange-realm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": { "node": ">=22", "pnpm": ">=10" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"] },
  "scripts": {
    "dev": "pnpm --parallel --filter @strange-realm/server --filter @strange-realm/web dev",
    "demo": "tsx scripts/demo.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:integration",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:browser": "tsx scripts/browser-test.ts"
  },
  "devDependencies": { "@types/node": "^22.15.0", "typescript": "~5.8.3", "tsx": "^4.19.4", "vitest": "^3.2.4", "playwright": "^1.56.0", "colyseus.js": "0.16.22" }
}
